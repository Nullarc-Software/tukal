{
	"name": "tukal-vue",
	"version": "0.2.7",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:types": "vue-tsc --noEmit --watch",
		"build": "vue-tsc --noEmit && vite build --debug",
		"build:dev": "vue-tsc --noEmit && vite build --mode development --debug",
		"generate-types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
		"serve": "vite preview",
		"test": "vitest --run --environment jsdom"
	},
	"main": "dist/tukal-vue.umd.cjs",
	"module": "./dist/tukal-vue.js",
	"files": [
		"dist/*"
	],
	"types": "./dist/lib.d.ts",
	"typings": "./dist/lib.d.ts",
	"exports": {
		".": {
			"import": "./dist/tukal-vue.js",
			"require": "./dist/tukal-vue.umd.cjs"
		},
		"./css": "./dist/tukal-vue.css"
	},
	"dependencies": {
		"@caohenghu/vue-colorpicker": "^1.2.4",
		"@nullarc/vuese3-cli": "^1.0.1",
		"@tiptap/extension-character-count": "^2.11.2",
		"@tiptap/extension-text-align": "^2.11.2",
		"@tiptap/extension-underline": "^2.11.2",
		"@tiptap/starter-kit": "^2.11.2",
		"@tiptap/vue-3": "^2.11.2",
		"dayjs": "^1.11.13",
		"jspdf": "^2.5.2",
		"jspdf-autotable": "^3.8.4",
		"lodash": "^4.17.21",
		"mustache": "^4.2.0",
		"path-to-regexp": "^8.2.0",
		"pinia": "^2.2.8",
		"vitest": "^2.1.8",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0",
		"vue3-click-away": "^1.2.4",
		"vue3-popper": "^0.1.0"
	},
	"devDependencies": {
		"@types/lodash": "^4.17.13",
		"@types/node": "^22.10.2",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vue/test-utils": "^2.4.6",
		"axios": "^1.7.9",
		"eslint": "^8.57.1",
		"eslint-plugin-vue": "^9.31.0",
		"jsdom": "^25.0.1",
		"material-icons": "^1.13.12",
		"node": "^22.12.0",
		"sass": "^1.83.0",
		"typescript": "^5.7.2",
		"unplugin-vue-components": "^0.27.4",
		"vite": "^6.0.5",
		"vite-plugin-dts": "^4.5.4",
		"vue-eslint-parser": "^9.4.3",
		"vue-tsc": "^2.2.0"
	}
}
